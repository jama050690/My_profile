{
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm run build:css && vite",
    "watch:css": "pnpm exec tailwindcss -i ./css/styles.css -o ./src/generated.css --watch",
    "build:css": "pnpm exec tailwindcss -i ./css/styles.css -o ./src/generated.css --minify",
    "build": "pnpm run build:css && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@vitejs/plugin-react": "^6.0.1",
    "prompt-sync": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.3"
  }
}
